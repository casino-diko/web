# Where players' browsers reach the socket-server (window.socket)
APP_SOCKET=http://localhost:8000

# MongoDB shared with the game-server (dealers, users, vendors live in MONGO_SHARED_DB)
MONGO_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
MONGO_SHARED_DB=nihtan_api
BACCARAT_DB=baccarat
DRAGONTIGER_DB=dragontiger
POKER_DB=poker

# Session cookie signing key (at least 32 random characters)
SESSION_SECRET=change-me-change-me-change-me-change-me
SESSION_COOKIE=nihtan
# set when the site is served over https
SESSION_SECURE=false

# Vendor API used for seamless-wallet balance checks and transactions
API_URL=

# Enables /login (pick any seeded user). Never enable in production.
DEV_LOGIN=true

# Live video per table when game_tables.env_setting.hls is not set
# (placeholders {app} {game} {table} {table2} {quality}); fake local streams: run the backend with COMPOSE_PROFILES=dev
#HLS_URL_TEMPLATE=http://localhost:8080/hls/{app}-{table}.m3u8
